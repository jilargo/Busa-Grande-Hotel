# ---- Application ----
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
APP_NAME="Busa Grande Hotel"

# Optional. Leave empty when the app is served from its own domain (Herd/Laravel Valet style).
# Set it (e.g. /busa-grande-hotel/public) when served from a sub-folder such as XAMPP htdocs.
APP_BASE_PATH=

# Currency symbol prefixed to all money values (e.g. ₱, $, MX$).
CURRENCY=₱

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=busa_grande_hotel
DB_USERNAME=busa_app
DB_PASSWORD=Busa_Dev_2026!

# ---- Session ----
SESSION_NAME=busa_session
SESSION_LIFETIME=120

# ---- Google OAuth 2.0 ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=